{
  "name": "corecoder-ts",
  "version": "0.1.0",
  "description": "TypeScript port of CoreCoder — minimal AI coding agent with an AsyncGenerator event-stream core. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "corecoder-ts": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/cli.js",
    "demo": "node dist/src/cli.js --demo",
    "test": "npm run clean && npm run build && node scripts/run-tests.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "openai": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
